        "jsCode": "// 1. Target the exact n8n Gemini output structure ($json.content.parts[0].text)\nconst rawText = $json?.content?.parts?.[0]?.text \n             || $json?.parts?.[0]?.text \n             || $json?.candidates?.[0]?.content?.parts?.[0]?.text \n             || $json?.text \n             || \"\";\n\n// 2. Catch genuinely empty payloads\nif (!rawText.trim()) {\n  return {\n    error: \"No text found in incoming item.\",\n    raw_node_input: $json\n  };\n}\n\n// 3. Extract pure JSON between outer braces\nconst jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\nconst sanitizedText = jsonMatch ? jsonMatch[0] : rawText.trim();\n\n// 4. Parse cleanly into n8n data fields\ntry {\n  return JSON.parse(sanitizedText);\n} catch (error) {\n  return {\n    parse_error: \"Found text, but JSON parsing failed.\",\n    raw_text: rawText\n  };\n}"
